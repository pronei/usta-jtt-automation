{
  "name": "momentum-tennis-score-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/storage-submit.test.ts tests/dry-run.test.ts tests/academy.test.ts",
    "capture": "tsx src/cli/capture-context.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:browser",
    "test:browser": "tsx --test tests/browser.test.ts",
    "format": "prettier --write src tests config README.md",
    "dry-run": "tsx src/cli/dry-run.ts",
    "scores": "tsx src/cli/read-scores.ts"
  },
  "dependencies": {
    "playwright": "^1.55.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.19.0"
}
