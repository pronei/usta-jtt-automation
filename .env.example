# Fill locally. Quote passwords containing # or spaces. Never commit credentials.
USTA_USERNAME=""
USTA_PASSWORD=""
ACADEMY_NAME="Momentum Tennis"
# Optional comma-separated aliases, or authoritative official team IDs.
ACADEMY_ALIASES=""
ACADEMY_TEAM_IDS=""
TENNISLINK_ENTRY_URL=https://tennislink.usta.com/TeamTennis/Secure/EnterMatchNumber.aspx
TENNISLINK_SELECTORS=config/selectors.local.json
TENNISLINK_PROFILE_DIR=var/browser-profile
# Set this to a verified score/schedule listing for your teams or league.
TENNISLINK_SCORES_URL=""
TENNISLINK_SCORE_SELECTORS=config/score-selectors.local.json
TENNISLINK_MAX_SCORE_PAGES=10
# Optional calibrated login selector file; blank uses manual sign-in.
TENNISLINK_LOGIN_SELECTORS=""
DATABASE_PATH=var/momentum.sqlite
ENABLE_FINAL_SUBMISSION=false
# Vision adapter for scorecard interpretation (see src/pipeline/ports.ts).
# Provider-agnostic; no SDK is wired up yet.
VISION_API_KEY=""
VISION_MODEL=""
